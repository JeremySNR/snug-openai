{
  "name": "@jeremysnr/snug-openai",
  "version": "0.2.0",
  "description": "snug for the OpenAI SDK. Fit chat messages into a token budget, ready to pass to client.chat.completions.create.",
  "keywords": [
    "llm",
    "tokens",
    "context-window",
    "openai",
    "gpt"
  ],
  "license": "MIT",
  "author": "Jeremy Smith",
  "homepage": "https://github.com/JeremySNR/snug-openai#readme",
  "bugs": {
    "url": "https://github.com/JeremySNR/snug-openai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeremySNR/snug-openai.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node node_modules/jest/bin/jest.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@jeremysnr/snug": ">=0.1.0 <0.3.0",
    "tiktoken": "^1.0.22"
  },
  "peerDependencies": {
    "openai": ">=4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "openai": "^4.0.0",
    "ts-jest": "^29.1.5",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0"
  }
}
